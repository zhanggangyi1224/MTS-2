# MTS-2 Project .gitignore
# Excludes large data files, model checkpoints, and temporary files

# ============================================================================
# Audio Data Files (Large - Do not commit)
# ============================================================================
fma_data/
*.mp3
*.wav
*.flac
*.ogg
*.m4a

# Generated audio samples
generated_samples/
demo_output/
test_output/

# Augmented audio
data/augmented/audio/
data/augmented/*.wav

# Large manifest files (> 100MB)
data/augmented/augmentation_manifest.json
data/augmented/*.json

# ============================================================================
# Model Checkpoints & Weights (Large - Do not commit)
# ============================================================================
checkpoints/
*.pt
*.pth
*.ckpt
*.safetensors

# Cache directories for pretrained models
cache/
.cache/
huggingface/

# ============================================================================
# Processed Data (Can be regenerated)
# ============================================================================
outputs/
data/processed/
*.pkl
*.pickle
*.npy
*.npz

# ============================================================================
# Logs & Temporary Files
# ============================================================================
*.log
training.log
fma_download.log
fma_manual_download.log

# Test results
test_results/

# Temporary files
*.tmp
*.temp
.DS_Store
Thumbs.db

# ============================================================================
# Python
# ============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
ENV/
env/
.venv

# ============================================================================
# Jupyter Notebooks
# ============================================================================
.ipynb_checkpoints
*.ipynb

# ============================================================================
# IDE & Editors
# ============================================================================
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# ============================================================================
# SLURM
# ============================================================================
slurm-*.out
slurm-*.err
*.sbatch.log

# ============================================================================
# Documentation (Generated)
# ============================================================================
# Keep markdown files but ignore some auto-generated ones
# Uncomment if you want to exclude certain docs:
# DATASET_DOWNLOAD_STATUS.md
# DOWNLOADING_DATASET.md

# ============================================================================
# MacOS
# ============================================================================
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# ============================================================================
# Linux
# ============================================================================
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ============================================================================
# Windows
# ============================================================================
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# ============================================================================
# Keep Important Files (Force include)
# ============================================================================
# Keep essential configs and scripts
!config/*.yaml
!*.py
!*.sh
!*.md
!requirements.txt

# Keep one small example audio if needed
# !examples/sample.wav

# Keep dataset metadata (small CSV files)
!fma_data/fma_metadata/*.csv
!fma_data/fma_metadata/README.txt

# Keep structure of empty directories
!data/.gitkeep
!outputs/.gitkeep
!checkpoints/.gitkeep
!generated_samples/.gitkeep
